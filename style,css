:root {
    --pokeball-red: #ee1515;
    --pokeball-red-dark: #cc0000;
    --pokeball-white: #f0f0f0;
    --pokeball-black: #222224;
    --pokeball-gray: #333333;
    --poke-yellow: #ffcb05;
    --poke-blue: #3b4cca;
    --bg-dark: #121216;
}

body {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    background-color: var(--bg-dark);
    color: #ffffff;
    margin: 0;
    padding: 40px 20px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}

/* Pokéball Badge Header */
.hub-header {
    text-align: center;
    margin-bottom: 40px;
}

.pokeball-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(to bottom, var(--pokeball-red) 50%, var(--pokeball-white) 50%);
    border-radius: 50%;
    border: 5px solid var(--pokeball-black);
    position: relative;
    margin: 0 auto 16px;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.4);
}

.pokeball-icon::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 6px;
    background-color: var(--pokeball-black);
    transform: translateY(-50%);
}

.pokeball-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
    background-color: var(--pokeball-white);
    border: 4px solid var(--pokeball-black);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--pokeball-white);
}

h1 {
    margin: 0 0 10px 0;
    font-size: 2.2rem;
    letter-spacing: 1px;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.5);
}

p.subtitle {
    color: #b0b0c0;
    margin: 0;
    font-size: 1rem;
}

/* Grid & Cards */
.grid {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 900px;
    width: 100%;
}

.card {
    background: #1e1e28;
    border-radius: 20px;
    padding: 30px 24px;
    width: 260px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    border: 3px solid #2d2d3d;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    transition: all 0.25s ease-in-out;
    position: relative;
    overflow: hidden;
}

.card:hover {
    transform: translateY(-8px);
}

.card.pikachu:hover {
    border-color: #fcd116;
    box-shadow: 0 12px 30px rgba(252, 209, 22, 0.35);
}

.card.snorlax:hover {
    border-color: #2d5d6b;
    box-shadow: 0 12px 30px rgba(45, 93, 107, 0.45);
}

.icon {
    font-size: 3rem;
    margin-bottom: 12px;
}

.card h3 {
    margin: 0 0 6px 0;
    font-size: 1.3rem;
}

.card-desc {
    color: #9e9eb0;
    font-size: 0.88rem;
    margin: 0 0 20px 0;
}

.btn {
    display: inline-block;
    padding: 10px 24px;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--pokeball-red), var(--pokeball-red-dark));
    color: #ffffff;
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 12px rgba(238, 21, 21, 0.4);
    transition: filter 0.2s ease;
}

.card:hover .btn {
    filter: brightness(1.15);
}
